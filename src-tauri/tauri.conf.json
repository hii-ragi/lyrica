{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyricgen",
  "version": "0.2.1",
  "identifier": "io.lyricgen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lyricgen",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "theme": "Light",
        "backgroundColor": "#f3ebdd"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/lyricgen-backend",
      "binaries/uv"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Japanese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "resources": {
      "resources/analysis/": "analysis/"
    }
  }
}
